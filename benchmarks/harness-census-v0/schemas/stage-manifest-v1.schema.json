{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness_census.stage_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "stage_id", "bench_commit", "crucible_commit", "crucible_binary_digest", "prime_package_digest", "dockerfile_digests", "package_digests", "profile_digest", "roster_digest", "catalog_digest", "harness_digest", "adapter_digest", "pack_digest", "mcp_digest", "task_digest", "grader_digest", "transport_network_mode", "network_enforcement", "task_network_enforcement", "retry_policy", "decision_policy"],
  "properties": {
    "schema_version": {"const": "harness_census.stage_manifest.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "bench_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "crucible_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "roster_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mcp_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grader_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crucible_binary_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "prime_package_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "dockerfile_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "package_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_enforcement": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "tool_surface_no_network_tool"}, "native_default": {"const": "host_allowlist_mint"}}},
    "transport_network_mode": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "public"}, "native_default": {"const": "no-network"}}},
    "task_network_enforcement": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "tool_surface_no_network_tool"}, "native_default": {"const": "host_allowlist_mint"}}},
    "controlled_tool_surface_probe": {"type": "object", "additionalProperties": true, "required": ["status", "network_enforcement", "adapters"], "properties": {"status": {"const": "passed"}, "network_enforcement": {"const": "tool_surface_no_network_tool"}, "adapters": {"type": "array", "minItems": 3}}},
    "retry_policy": {"type": "object", "required": ["product_retry", "transport_retry"], "properties": {"product_retry": {"const": 0}, "transport_retry": {"type": "integer", "minimum": 0}}},
    "decision_policy": {"type": "object", "required": ["hard_pass_requires_all_tasks", "native_default_separate"], "properties": {"hard_pass_requires_all_tasks": {"const": true}, "native_default_separate": {"const": true}}}
  }
}
