{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness_census.stage_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "stage_id", "bench_commit", "crucible_commit", "crucible_binary_digest", "prime_package_digest", "dockerfile_digests", "gateway_digests", "gateway_dockerfile_digests", "compose_digests", "package_digests", "profile_digest", "roster_digest", "catalog_digest", "adapter_digest", "pack_digest", "mcp_digest", "task_digest", "reference_hunk_map_digest", "grader_digest", "transport_network_mode", "network_enforcement", "task_network_enforcement", "retry_policy", "decision_policy"],
  "properties": {
    "schema_version": {"const": "harness_census.stage_manifest.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "bench_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "crucible_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "roster_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mcp_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_hunk_map_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grader_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crucible_binary_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "prime_package_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "dockerfile_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "gateway_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "gateway_dockerfile_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "compose_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "package_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_enforcement": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "docker_internal_mint_gateway"}, "native_default": {"const": "docker_internal_mint_gateway"}}},
    "transport_network_mode": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "allowlist"}, "native_default": {"const": "allowlist"}}},
    "task_network_enforcement": {"type": "object", "additionalProperties": false, "required": ["controlled", "native_default"], "properties": {"controlled": {"const": "docker_internal_network"}, "native_default": {"const": "docker_internal_network"}}},
    "controlled_tool_surface_probe": {"type": "object", "additionalProperties": true, "required": ["status", "task_network", "adapters"], "properties": {"status": {"const": "passed"}, "task_network": {"const": "denied_by_tool_and_sandbox"}, "adapters": {"type": "array", "minItems": 3}}},
    "retry_policy": {"type": "object", "required": ["product_retry", "transport_retry"], "properties": {"product_retry": {"const": 0}, "transport_retry": {"type": "integer", "minimum": 0}}},
    "decision_policy": {"type": "object", "required": ["decision", "task_buckets", "paired_delta_resolvable", "interval_claims", "forbidden_claims", "cell_invalidation", "hard_pass_requires_all_tasks", "native_default_separate"], "properties": {"decision": {"const": "scale_or_repair"}, "task_buckets": {"const": 3}, "paired_delta_resolvable": {"type": "object", "required": ["point_delta"], "properties": {"point_delta": {"const": 1.0}}}, "interval_claims": {"type": "object", "required": ["descriptive", "inferential"], "properties": {"descriptive": {"const": true}, "inferential": {"const": false}}}, "forbidden_claims": {"type": "array", "contains": {"const": "winner"}, "minItems": 3}, "cell_invalidation": {"const": "any_reliability_failure"}, "hard_pass_requires_all_tasks": {"const": true}, "native_default_separate": {"const": true}}},
    "worker_preflight_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cells": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "object", "required": ["summary", "tasks"], "properties": {"summary": {"type": "object"}, "tasks": {"type": "array", "minItems": 3}}}}
  }
}
