{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness_census.trial_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "crucible_run_id", "cell_kind", "campaign_id", "stage_manifest_digest", "trial_id", "source_cluster", "task_id", "task_digest", "row_id", "cohort_id", "baseline_id", "profile_digest", "model_requested", "effort_requested", "provider_route_resolved", "provider_effort_resolved", "response_model_attestation", "response_effort_attestation", "response_identity_verified", "default_resolution_source", "harness", "harness_version", "composition", "composition_digest", "adapter_digest", "system_identity", "system_prompt_digest", "context_digest", "skill_digest", "mcp_digest", "tool_manifest_digest", "trial_status", "failure_class", "failure_stage", "failure_code", "failure_detail_ref", "hard_pass", "task_points", "transport_retry_count", "evidence_refs", "transcript_ref", "grader_receipt_ref"],
  "properties": {
    "schema_version": {"const": "harness_census.trial_receipt.v1"},
    "crucible_run_id": {"type": "string", "minLength": 1},
    "cell_kind": {"enum": ["controlled", "native_default"]},
    "campaign_id": {"type": "string", "minLength": 1},
    "stage_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_id": {"type": "string", "minLength": 1},
    "source_cluster": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cohort_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "baseline_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_requested": {"type": ["string", "null"]},
    "effort_requested": {"type": ["string", "null"]},
    "provider_route_resolved": {"type": ["string", "null"]},
    "provider_effort_resolved": {"type": ["string", "null"]},
    "response_model_attestation": {"type": ["string", "null"]},
    "response_effort_attestation": {"type": ["string", "null"]},
    "response_identity_verified": {"type": ["boolean", "null"]},
    "default_resolution_source": {"type": ["string", "null"]},
    "harness": {"enum": ["prime", "omp", "pi"]},
    "harness_version": {"type": "string", "minLength": 1},
    "composition": {"enum": ["controlled_raw", "controlled_enriched", "native_default"]},
    "composition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "system_identity": {"type": ["string", "null"]},
    "system_prompt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mcp_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_status": {"enum": ["success", "quality_failure", "reliability_failure"]},
    "failure_class": {"type": ["string", "null"]},
    "failure_stage": {"type": ["string", "null"]},
    "failure_code": {"type": ["string", "null"]},
    "failure_detail_ref": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}@[^/].*$"},
    "hard_pass": {"type": ["boolean", "null"]},
    "task_points": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "transport_retry_count": {"type": "integer", "minimum": 0},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}@[^/].*$"}},
    "transcript_ref": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}@[^/].*$"},
    "grader_receipt_ref": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}@[^/].*$"}
  },
  "allOf": [
    {"if": {"properties": {"cell_kind": {"const": "controlled"}}}, "then": {"required": ["row_id", "cohort_id"], "properties": {"row_id": {"type": "string"}, "cohort_id": {"type": "string"}}}},
    {"if": {"properties": {"cell_kind": {"const": "native_default"}}}, "then": {"required": ["baseline_id"], "properties": {"composition": {"const": "native_default"}, "row_id": {"type": "null"}, "cohort_id": {"type": "null"}}}},
    {"if": {"properties": {"trial_status": {"enum": ["success", "quality_failure"]}}}, "then": {"required": ["hard_pass", "task_points", "response_identity_verified", "transcript_ref", "grader_receipt_ref"], "properties": {"response_identity_verified": {"const": true}}}},
    {"if": {"properties": {"trial_status": {"const": "reliability_failure"}}}, "then": {"required": ["failure_class", "failure_stage", "failure_code"], "properties": {"hard_pass": {"type": "null"}, "task_points": {"type": "null"}}}}
  ]
}
