{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness_census.comparison.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "stage_manifest_digest", "model_requested", "effort_requested", "cohort_id", "claim_scope", "task_digests", "rows", "trial_ids", "receipt_digests", "harness_versions", "composition_digests"],
  "properties": {
    "schema_version": {"const": "harness_census.comparison.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "stage_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_requested": {"type": "string", "minLength": 1},
    "effort_requested": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_scope": {"enum": ["cross_harness", "product_local"]},
    "task_digests": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "rows": {"type": "array", "items": {"type": "object", "required": ["row_id", "harness", "composition", "provider_route_resolved", "provider_effort_resolved"], "properties": {"row_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "harness": {"enum": ["prime", "omp", "pi"]}, "composition": {"enum": ["controlled_raw", "controlled_enriched"]}, "provider_route_resolved": {"type": "string"}, "provider_effort_resolved": {"type": "string"}}}},
    "trial_ids": {"type": "array", "minItems": 18, "items": {"type": "string", "minLength": 1}},
    "receipt_digests": {"type": "array", "minItems": 18, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "harness_versions": {"type": "object"},
    "composition_digests": {"type": "object"}
  },
  "allOf": [{"if": {"properties": {"claim_scope": {"const": "cross_harness"}}}, "then": {"properties": {"rows": {"minItems": 6, "maxItems": 6}}}}, {"if": {"properties": {"claim_scope": {"const": "product_local"}}}, "then": {"properties": {"rows": {"minItems": 1}}}}]
}
